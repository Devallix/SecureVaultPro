/* SecureVault Pro - Dark Theme */

QMainWindow {
    background: #1a1a2e;
}

QWidget {
    background: #1a1a2e;
    color: #e0e0e0;
    font-family: "Segoe UI", "SF Pro Display", sans-serif;
}

QFrame#sidebar {
    background: #16162a;
    border-right: 1px solid #2a2a4a;
}

QFrame#detailsPanel {
    background: #16162a;
    border-left: 1px solid #2a2a4a;
}

QLabel {
    color: #e0e0e0;
    background: transparent;
}

QPushButton {
    background: #2a2a4a;
    color: #e0e0e0;
    border: 1px solid #3a3a5a;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 12px;
}

QPushButton:hover {
    background: #3a3a5a;
    border-color: #4a4a6a;
}

QPushButton:pressed {
    background: #4a4a6a;
}

QPushButton:disabled {
    background: #1e1e3a;
    color: #666;
}

QLineEdit {
    background: #2a2a3a;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 8px 12px;
    color: white;
    font-size: 13px;
    selection-background-color: #3B82F6;
}

QLineEdit:focus {
    border-color: #3B82F6;
}

QTextEdit, QPlainTextEdit {
    background: #2a2a3a;
    border: 1px solid #444;
    border-radius: 6px;
    color: white;
    padding: 8px;
}

QComboBox {
    background: #2a2a3a;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 6px 12px;
    color: white;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background: #2a2a3a;
    border: 1px solid #444;
    color: white;
    selection-background-color: #3B82F6;
}

QScrollBar:vertical {
    background: #1a1a2e;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #3a3a5a;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QStatusBar {
    background: #12122a;
    color: #666;
    border-top: 1px solid #2a2a4a;
    font-size: 11px;
}

QToolTip {
    background: #2a2a4a;
    color: #e0e0e0;
    border: 1px solid #3a3a5a;
    border-radius: 4px;
    padding: 4px 8px;
}

QMenu {
    background: #1e1e3a;
    border: 1px solid #3a3a5a;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #3B82F6;
}

QHeaderView::section {
    background: #16162a;
    color: #999;
    border: none;
    border-bottom: 1px solid #2a2a4a;
    padding: 8px;
    font-weight: bold;
}
