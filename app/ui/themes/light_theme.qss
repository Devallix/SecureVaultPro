/* SecureVault Pro - Light Theme */

QMainWindow {
    background: #f5f5f7;
}

QWidget {
    background: #f5f5f7;
    color: #1a1a2e;
    font-family: "Segoe UI", "SF Pro Display", sans-serif;
}

QFrame#sidebar {
    background: #e8e8ed;
    border-right: 1px solid #d0d0d8;
}

QFrame#detailsPanel {
    background: #e8e8ed;
    border-left: 1px solid #d0d0d8;
}

QLabel {
    color: #1a1a2e;
    background: transparent;
}

QPushButton {
    background: #e0e0e8;
    color: #1a1a2e;
    border: 1px solid #c0c0c8;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 12px;
}

QPushButton:hover {
    background: #d0d0d8;
}

QPushButton:pressed {
    background: #c0c0c8;
}

QPushButton:disabled {
    background: #e8e8ec;
    color: #aaa;
}

QLineEdit {
    background: #ffffff;
    border: 1px solid #c0c0c8;
    border-radius: 6px;
    padding: 8px 12px;
    color: #1a1a2e;
    font-size: 13px;
}

QLineEdit:focus {
    border-color: #3B82F6;
}

QLineEdit:disabled {
    background: #e8e8ec;
    color: #999;
}

QTextEdit, QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #c0c0c8;
    border-radius: 6px;
    color: #1a1a2e;
    padding: 8px;
}

QStatusBar {
    background: #e8e8ed;
    color: #666;
    border-top: 1px solid #d0d0d8;
    font-size: 11px;
}

QComboBox {
    background: #ffffff;
    border: 1px solid #c0c0c8;
    border-radius: 6px;
    padding: 6px 12px;
    color: #1a1a2e;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #c0c0c8;
    color: #1a1a2e;
    selection-background-color: #3B82F6;
    selection-color: white;
}

QScrollBar:vertical {
    background: #f5f5f7;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #c0c0c8;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QHeaderView::section {
    background: #e8e8ed;
    color: #444;
    border: none;
    border-bottom: 1px solid #d0d0d8;
    padding: 8px;
    font-weight: bold;
}

QToolTip {
    background: #ffffff;
    color: #1a1a2e;
    border: 1px solid #c0c0c8;
    border-radius: 4px;
    padding: 4px 8px;
}

QMenu {
    background: #ffffff;
    border: 1px solid #d0d0d8;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #3B82F6;
    color: white;
}
